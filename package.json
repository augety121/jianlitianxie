{
  "name": "jianlitianxie",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bridge/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-release.mjs",
    "test:dom": "python tests/browser-regression.py --isolated-dom",
    "test:guards": "python tests/performance-browser.py",
    "bench": "python tests/performance-bench.py",
    "test:ui": "python tests/transport-ui.py",
    "bench:transport": "node tests/transport-bench.mjs",
    "test:workspace": "python tests/workspace-ui.py",
    "test:mv3": "python tests/workspace-mv3.py",
    "test:compatibility": "python tests/compatibility-browser.py",
    "test:local": "python tests/local-first-browser.py",
    "test:local-mv3": "python tests/local-first-mv3.py",
    "test:jev": "python tests/jev-execution-browser.py",
    "bench:jev": "python tests/jev-local-bench.py",
    "test:page-mv3": "python tests/page-entry-mv3.py",
    "test:oneclick": "python tests/oneclick-browser.py && python tests/picker-layout.py",
    "test:learn": "python tests/learn-browser.py",
    "test:recognition": "python tests/recognition-repair-browser.py",
    "test:recognition-mv3": "python tests/recognition-repair-mv3.py",
    "test:recovery": "node --test tests/recovery.test.mjs && python tests/recovery-browser.py",
    "test:recovery-mv3": "python tests/recovery-mv3.py",
    "test:empty-records": "python tests/empty-record-browser.py",
    "test:empty-mv3": "python tests/empty-record-mv3.py",
    "build:engine": "node scripts/build-engine.mjs",
    "test:components": "python tests/component-adapters-browser.py",
    "test:readiness": "python tests/readiness-browser.py",
    "test:readiness-mv3": "python tests/readiness-mv3.py",
    "test:moka": "python tests/moka-browser.py",
    "test:moka-mv3": "python tests/moka-mv3.py"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
